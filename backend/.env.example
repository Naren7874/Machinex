# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ===========================================
# DATABASE (MongoDB Atlas)
# ===========================================
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/machinery?retryWrites=true&w=majority

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a strong secret using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# GOOGLE CLOUD APIS (Optional - for AI features)
# ===========================================
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=

# ===========================================
# CLOUDINARY (Optional - for image upload)
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# RAZORPAY (Optional - for payments)
# ===========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===========================================
# WHATSAPP (Optional - for WhatsApp integration)
# ===========================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
